# TerminAI Configuration
# Copy this file to .env and fill in your values.

# AI Provider: "local" for llama-cpp-python, "api" for OpenAI-compatible API
TERMINAI_AI_PROVIDER=api

# OpenAI-compatible API settings
TERMINAI_API_KEY=sk-your-api-key-here
TERMINAI_MODEL=gpt-3.5-turbo
TERMINAI_API_BASE=https://api.openai.com/v1

# Local model settings (only needed if TERMINAI_AI_PROVIDER=local)
TERMINAI_LOCAL_MODEL_PATH=/path/to/your/model.gguf
TERMINAI_LOCAL_MODEL_CONTEXT=2048
TERMINAI_LOCAL_MODEL_THREADS=4

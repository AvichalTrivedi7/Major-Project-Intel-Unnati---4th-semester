# TerminAI Configuration
# Copy this file to .env and fill in your values.

# AI Provider: "google" for Gemini API, "local" for llama-cpp-python
TERMINAI_AI_PROVIDER=google

# Google AI Studio (Gemini) settings
TERMINAI_GOOGLE_API_KEY=your_google_api_key_here
TERMINAI_GOOGLE_MODEL=gemini-2.5-flash

# Local model settings (only needed if TERMINAI_AI_PROVIDER=local)
TERMINAI_LOCAL_MODEL_PATH=/path/to/your/model.gguf
TERMINAI_LOCAL_MODEL_CONTEXT=2048
TERMINAI_LOCAL_MODEL_THREADS=4
